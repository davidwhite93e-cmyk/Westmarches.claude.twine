:: StoryTitle
Tales of the Western Reach

:: StoryData
{
  "ifid": "D6B3F7A2-4C1E-4E8B-9A57-2F0C1B8E5A31",
  "format": "SugarCube",
  "format-version": "2.36.1",
  "start": "Start"
}

:: Story JavaScript [script]
/* ---------- Dice-pool rules: Attributes, Hits, Sparks ---------- */
setup.attributes = ["vig", "fin", "wit", "pre"];
setup.attributeNames = { vig: "Vigor", fin: "Finesse", wit: "Wits", pre: "Presence" };
setup.attributeDesc = { vig: "strength, toughness, raw force", fin: "agility, aim, quick hands", wit: "perception, learning, cunning", pre: "will, charm, force of personality" };
setup.roll = function (n, d) { var t = 0; for (var i = 0; i < n; i++) t += random(1, d); return t; };

/* Roll a pool of d6 plus one Fate die. 4+ is a hit. Fate 6 = two hits, Fate 1 cancels one hit. */
setup.rollPool = function (n, noLuck) {
  var v = State.variables, dice = [], hits = 0, d, i;
  n = Math.max(1, n);
  for (i = 0; i < n; i++) {
    d = random(1, 6);
    if (d === 1 && v.race === "Smallfolk" && !noLuck) d = random(1, 6);   /* Lucky */
    dice.push(d);
    if (d >= 4) hits++;
  }
  var w = random(1, 6), note = "";
  if (w === 6) { hits += 2; note = "Fate triumph: +2 hits"; }
  else if (w === 1 && hits > 0) { hits--; note = "Fate snag: -1 hit"; }
  return { dice: dice, wild: w, hits: hits, note: note, n: n };
};

/* ---------- Lineages ---------- */
setup.races = {
  "Human":        { bonus: { pre: 1, wit: 1 }, dark: false, skill: null,
                    summary: "Ambitious and adaptable, found in every city of the Western Reach.",
                    traits: "+1 Presence, +1 Wits. Adaptable: you begin each rest with an extra Spark." },
  "Elf":          { bonus: { fin: 1, wit: 1 }, dark: true, skill: "Perception",
                    summary: "Graceful, long-lived, and sharp-eyed.",
                    traits: "+1 Finesse, +1 Wits. Nightsight. Trained in Perception." },
  "Dwarf":        { bonus: { vig: 2 }, dark: true, skill: null,
                    summary: "Stout and stubborn, born to stone and hard work.",
                    traits: "+2 Vigor. Nightsight. Stone-hardy: you take half damage from traps and poison." },
  "Smallfolk":     { bonus: { fin: 1, pre: 1 }, dark: false, skill: null,
                    summary: "Small, brave, and famously lucky.",
                    traits: "+1 Finesse, +1 Presence. Lucky: any die showing a 1 is rerolled once." },
  "Tuskborn":     { bonus: { vig: 2 }, dark: true, skill: "Intimidation",
                    summary: "Fierce and enduring, marked by tusks and old blood.",
                    traits: "+2 Vigor. Nightsight. Trained in Intimidation. Relentless: once per rest, drop to 1 Stamina instead of 0." },
  "Hellmarked":   { bonus: { pre: 1, wit: 1 }, dark: true, skill: "Deception",
                    summary: "Bearing an infernal brand, and the stares that come with it.",
                    traits: "+1 Presence, +1 Wits. Nightsight. Trained in Deception." },
  "Drakeblood":   { bonus: { vig: 1, pre: 1 }, dark: false, skill: null,
                    summary: "Proud, scaled, and draconic in blood.",
                    traits: "+1 Vigor, +1 Presence. Breath Weapon: once per rest, 4 damage that ignores Guard." },
  "Gnome":        { bonus: { wit: 2 }, dark: true, skill: "Investigation",
                    summary: "Curious, inventive, and hard to fool.",
                    traits: "+2 Wits. Nightsight. Trained in Investigation. Tinker's Mind: +1 die on Wits checks." },
  "Twilight-kin": { bonus: { pre: 1, fin: 1 }, dark: true, skill: "Discernment",
                    summary: "Charming, adaptable, and welcome almost anywhere.",
                    traits: "+1 Presence, +1 Finesse. Nightsight. Trained in Discernment." }
};

/* ---------- Callings ---------- */
setup.classes = {
  "Blade": { atk: "vig", weapon: "longsword", dmg: 2, armor: 2, vit: 3, skills: ["Athletics", "Intimidation"],
    feat: "Cleaving Blow", featDesc: "an attack that deals +3 damage",
    gear: ["Longsword", "Chain hauberk", "Shield"],
    summary: "Armored, tough, and steady with any weapon.",
    rec: { vig: 4, fin: 2, wit: 2, pre: 2 } },
  "Shadow": { atk: "fin", weapon: "dagger", dmg: 2, armor: 1, vit: 2, skills: ["Stealth", "Pilfering"],
    feat: "Backstab", featDesc: "an attack with +3 dice that ignores 1 Guard",
    gear: ["Dagger", "Leather coat", "Lockpicks"],
    summary: "Quick, quiet, and lethal when the guard drops.",
    rec: { vig: 1, fin: 4, wit: 3, pre: 2 } },
  "Spellwright": { atk: "wit", weapon: "Ember Bolt", dmg: 3, armor: 1, vit: 1, skills: ["Occult", "Investigation"],
    feat: "Arcane Bolt", featDesc: "raw force that ignores Guard and deals +3 damage",
    gear: ["Quarterstaff", "Spellbook", "Component pouch"],
    summary: "A scholar of the hidden currents of magic who bends reality with study.",
    rec: { vig: 1, fin: 2, wit: 4, pre: 3 } },
  "Vowed": { atk: "vig", weapon: "mace", dmg: 2, armor: 2, vit: 3, skills: ["Medicine", "Religion"],
    feat: "Mending Prayer", featDesc: "heal 4 + Presence Stamina",
    gear: ["Mace", "Chain hauberk", "Shield", "Holy symbol"],
    summary: "Sworn to a higher power, armed with faith and a heavy mace.",
    rec: { vig: 3, fin: 1, wit: 3, pre: 3 } },
  "Wayfarer": { atk: "fin", weapon: "longbow", dmg: 2, armor: 1, vit: 3, skills: ["Survival", "Perception"],
    feat: "Twin Shot", featDesc: "make two attacks at once",
    gear: ["Longbow", "Scale vest", "Hunting knife"],
    summary: "A wanderer of the wilds, deadly at range.",
    rec: { vig: 2, fin: 4, wit: 3, pre: 1 } },
  "Voice": { atk: "fin", weapon: "rapier", dmg: 2, armor: 1, vit: 3, skills: ["Persuasion", "Performance"],
    feat: "Cutting Word", featDesc: "3 damage, and your foe attacks with 3 fewer dice next turn",
    gear: ["Rapier", "Leather coat", "Lute"],
    summary: "A silver-tongued performer whose words cut deeper than steel.",
    rec: { vig: 1, fin: 3, wit: 2, pre: 4 } }
};

/* ---------- Pasts ---------- */
setup.backgrounds = {
  "Old Soldier":      { skills: ["Athletics", "Intimidation"], gold: 10, gear: ["Rank insignia"], summary: "You served in a Highmarket or Ironquay garrison." },
  "Temple-raised":    { skills: ["Discernment", "Religion"], gold: 15, gear: ["Prayer book"], summary: "You grew up tending a temple." },
  "Gutter-born":      { skills: ["Deception", "Stealth"], gold: 15, gear: ["Crowbar", "Dark cloak"], summary: "You once worked the shadier side of the docks." },
  "Scholar":          { skills: ["Occult", "History"], gold: 10, gear: ["Bottle of ink", "Scholar's letter"], summary: "You spent years among scrolls and dusty archives." },
  "Wilder":           { skills: ["Survival", "Athletics"], gold: 10, gear: ["Hunting trap", "Traveler's pack"], summary: "You grew up far from any city wall." },
  "Village Champion": { skills: ["Beast-craft", "Survival"], gold: 10, gear: ["Farmer's tools"], summary: "Your village still tells the tale of what you did." }
};

/* ---------- Character building ---------- */
setup.sumBase = function (b) { var s = 0; setup.attributes.forEach(function (a) { s += b[a]; }); return s; };
setup.bump = function (a, dir) {
  var v = State.variables, nv = v.base[a] + dir;
  if (nv < 1 || nv > 4) return;
  var t = setup.sumBase(v.base) - v.base[a] + nv;
  if (t - 4 > 6) return;
  v.base[a] = nv;
  v.points = 10 - t;
};
setup.applyRec = function () {
  var v = State.variables;
  v.base = Object.assign({}, setup.classes[v.class].rec);
  v.points = 10 - setup.sumBase(v.base);
};
setup.sparkMax = function () { return 3 + (State.variables.race === "Human" ? 1 : 0); };
setup.finalize = function () {
  var v = State.variables, r = setup.races[v.race], c = setup.classes[v.class], b = setup.backgrounds[v.bg];
  v.final = {};
  setup.attributes.forEach(function (a) { v.final[a] = Math.min(5, v.base[a] + (r.bonus[a] || 0)); });
  var sk = [];
  c.skills.concat(b.skills, [v.extraSkill, r.skill]).forEach(function (s) { if (s && sk.indexOf(s) < 0) sk.push(s); });
  v.skills = sk;
  v.maxhp = 10 + 2 * v.final.vig + c.vit;
  v.hp = v.maxhp;
  v.guard = c.armor + (v.final.fin >= 3 ? 1 : 0);
  v.sparks = setup.sparkMax();
  v.breath = (v.race === "Drakeblood") ? 1 : 0;
  v.relentlessUsed = false;
  v.atkBonus = 0; v.rank = 0;
  v.potions = 2;
  v.gold = b.gold + 10;
  v.inv = c.gear.concat(b.gear);
};
setup.rest = function () {
  var v = State.variables;
  v.hp = v.maxhp;
  v.sparks = setup.sparkMax();
  v.breath = (v.race === "Drakeblood") ? 1 : 0;
  v.relentlessUsed = false;
  v.campTalk = {};
};
setup.heal = function (n) {
  var v = State.variables, before = v.hp;
  v.hp = Math.min(v.maxhp, v.hp + n);
  return v.hp - before;
};
setup.hurt = function (n) {   /* environmental damage never kills */
  var v = State.variables;
  v.hp = Math.max(1, v.hp - n);
};
setup.rank = function () {    /* milestone growth: +3 max Stamina each rank, +1 attack die every second rank */
  var v = State.variables;
  v.rank = (v.rank || 0) + 1;
  v.maxhp += 3;
  v.hp = Math.min(v.maxhp, v.hp + 3);
  if (v.rank % 2 === 0) v.atkBonus = (v.atkBonus || 0) + 1;
};

/* ---------- Checks: roll Attribute (+2 if Trained) dice, need N hits ---------- */
setup.check = function (attribute, skill, need) {
  var v = State.variables;
  var base = v.final[attribute];
  var trained = (skill && v.skills.indexOf(skill) >= 0) ? 2 : 0;
  var extra = (attribute === "wit" && v.race === "Gnome") ? 1 : 0;
  var extraLabel = "Tinker's Mind";
  if (skill === "Resolve") {   /* steadiness of mind or faith */
    trained = ["Religion", "Intimidation", "Discernment", "Performance"].some(function (s) { return v.skills.indexOf(s) >= 0; }) ? 2 : 0;
    if (v.survivor) { extra += 1; extraLabel = "Tam's company"; }
  }
  var pen = setup.dreadPenalty();
  var aid = 0, aidName = "";
  if (skill && (v.dread || 0) < 6) {
    (v.party || []).some(function (id) {
      var c = setup.companions[id];
      var ok = (skill === "Resolve")
        ? c.skills.some(function (s) { return ["Religion", "Intimidation", "Discernment", "Performance"].indexOf(s) >= 0; })
        : c.skills.indexOf(skill) >= 0;
      if (ok) { aid = 1; aidName = c.short; return true; }
      return false;
    });
  }
  var n = Math.max(1, base + trained + extra + aid - pen);
  var p = setup.rollPool(n);
  return { n: p.n, base: base, trained: trained, extra: extra, extraLabel: extraLabel, pen: pen, aid: aid, aidName: aidName, dice: p.dice, wild: p.wild, hits: p.hits, note: p.note,
           need: need, success: p.hits >= need, skill: skill || setup.attributeNames[attribute], attribute: setup.attributeNames[attribute] };
};

/* ---------- Crawl resources: Light, Dread, Provisions, the Stirring ---------- */
setup.dreadPenalty = function () { var d = State.variables.dread || 0; return d >= 6 ? 2 : (d >= 3 ? 1 : 0); };
setup.gainDread = function (n) { var v = State.variables; v.dread = Math.min(10, (v.dread || 0) + n); };
setup.easeDread = function (n) { var v = State.variables; v.dread = Math.max(0, (v.dread || 0) - n); };
setup.startDeep = function () {
  var v = State.variables;
  v.light = 6; v.prov = 2; v.flasks = 0; v.salt = 0; v.dread = 0;
  v.stir = 0; v.nextHunt = 6; v.moves = 0; v.hunt = false; v.huntDest = "";
  v.depth = 1; v.crawling = false; v.seen = {};
  v.survivor = false; v.knowsName = false; v.journal = false; v.chalk = false;
  v.checkpoint = "DeepAdit";
};
setup.burn = function (n) { var v = State.variables; v.light = Math.max(0, v.light - n); };
setup.stirCheck = function () {
  var v = State.variables;
  if (v.stir >= v.nextHunt) { v.hunt = true; v.nextHunt = v.stir + 6; }
};
setup.step = function () {
  var v = State.variables;
  v.moves++;
  if (!(setup.races[v.race].dark && v.moves % 2 === 0)) setup.burn(1);   /* nightsight stretches your light */
  v.stir++;
  if (v.light <= 0) setup.gainDread(1);                                    /* the dark feeds your fear */
  setup.stirCheck();
};
setup.camp = function () {
  var v = State.variables, chapel = (v.campAt === "DeepChapel");
  v.lastCampCost = setup.campCost();
  v.prov = Math.max(0, v.prov - v.lastCampCost);
  v.stir += chapel ? 1 : 2;
  setup.rest();
  setup.easeDread(chapel ? 4 : 3);
  setup.stirCheck();
};
setup.useFlask = function () { var v = State.variables; if (v.flasks > 0) { v.flasks--; v.light = Math.min(12, v.light + 6); } };
setup.useSalt = function () { var v = State.variables; if (v.salt > 0) { v.salt--; setup.easeDread(2); } };
setup.useDraught = function () { var v = State.variables; if (v.potions > 0) { v.potions--; setup.heal(setup.roll(1, 4) + 3); } };
setup.crawlSetback = function () {
  var v = State.variables;
  v.dread = Math.min(9, v.dread + 2); v.prov = Math.max(0, v.prov - 1); setup.burn(2); v.hunt = false;
};

/* ---------- Party: up to 2 companions ---------- */
setup.companions = {
  kess: { name: "Kess Dunmarrow", short: "Kess", title: "dwarf shield-warden", role: "Guardian", skills: ["Athletics", "Survival"], fee: 8,
    guard: 1, t3: { guard: 2 },
    roleText: "Raises your Guard by 1 each round (2 at Trust 3).",
    pitch: ["'A shield is only good if somebody stands behind it,' she says, thumping the rim. 'You look like you could use one.'"],
    talk: [
      ["Kess polishes her shield rim with a thumb. 'This came out of the Iron Steps, my clan's hold. Cave-in, twenty winters back. I keep the shield so I remember what I could not hold up.'"],
      ["'People think dwarves are not afraid of the dark,' she says quietly. 'We are more afraid. We know what lives in it.' She meets your eye. 'But I would rather face it beside someone who stays.'"],
      ["Kess holds her shield out between you and the dark, as if to show you. 'I have broken more shields than I can count. You are the first person I would break a new one for.' (Trust 3: her Bulwark grows stronger.)"]],
    chat: ["Kess runs a whetstone down her axe. 'A good edge and a good night's sleep. That's all a dwarf needs.'", "'Ever seen a mountain fall?' Kess asks. 'No? Good. Hope you never do.'"],
    banter: { victory: ["'That is how you hold a line,' Kess mutters, shaking out her arm.", "Kess spits. 'Barely a warm-up.'"],
              dread: ["'Eyes on my shield,' Kess says, stepping close. 'Not on that.'"],
              end: ["Kess claps you on the back hard enough to rattle your teeth. 'Next time, pick a job with more sunlight.'"] } },
  wren: { name: "Wren Ashgrove", short: "Wren", title: "aloof elf archer", role: "Striker", skills: ["Perception", "Stealth"], fee: 10,
    pool: 4, dmg: 2, t3: { pool: 5 },
    roleText: "Shoots each round with 4 dice, damage 2 (5 dice at Trust 3).",
    pitch: ["'Do not stand in front of my arrows,' says the elf, not looking up from her bowstring. 'Anywhere else is fine.'"],
    talk: [
      ["Wren watches the tree line. 'I am a hundred and forty. Do you know what that does to a person? Everything is a rerun. Villages, wars, kings. I keep looking for something new.' A pause. 'You are almost interesting.'"],
      ["'I had a sister,' Wren says, and does not say more for a while. 'She left to find something new, too. I have been looking for her trail for thirty years. It leads to every ruin and dead end.' Another pause. 'This is a nicer dead end than most.'"],
      ["Wren sets her bow down, which you have never seen her do. 'I stopped looking for her some time ago,' she admits. 'I have been looking for company. Do not tell anyone I said that.' (Trust 3: her aim sharpens.)"]],
    chat: ["Wren counts her arrows twice, silently. 'Habit,' she says.", "'The stars are wrong here,' Wren murmurs, looking up. 'Or I am.'"],
    banter: { victory: ["'Adequate,' Wren says, retrieving an arrow.", "Wren notches another arrow. 'Was that all of them? Pity.'"],
              dread: ["Wren's hand is steady on her bow, but her eyes keep going to the dark. 'I do not like this place,' she says softly."],
              end: ["Wren inclines her head, the closest she comes to a bow. 'That was almost worth the wait.'"] } },
  osric: { name: "Brother Osric Vale", short: "Osric", title: "gentle temple healer", role: "Healer", skills: ["Medicine", "Religion"], fee: 6,
    heal: 3, healEvery: 2, t3: { healEvery: 1 },
    roleText: "Mends you for 3 Stamina every second round (every round at Trust 3).",
    pitch: ["'I cannot fight,' Osric admits, twisting his prayer beads, 'but I can make sure you do not stay wounded. If you will have me.'"],
    talk: [
      ["Osric fiddles with his beads. 'I am not brave. I want to be. I have healed a hundred bodies and never once stood between anyone and a blade.' He gives a small smile. 'I would like to try.'"],
      ["'My teacher said faith is a lamp, not a wall,' says Osric. 'A wall keeps the dark out. A lamp lets you walk through it.' He glances at the shadows. 'I have been trying to be a lamp.'"],
      ["Osric presses his hands over yours. 'I have stopped waiting to be brave,' he says. 'I am just going to keep going.' A warm hum runs through you. (Trust 3: he mends you every round.)"]],
    chat: ["Osric sorts his bandages into neat rolls. 'It calms me,' he explains.", "'I pray for the ones we fight, too,' Osric admits. 'Do not tell anyone.'"],
    banter: { victory: ["Osric exhales. 'Thank the gods. Is anyone bleeding? Sit, sit.'", "'Oh, well done,' Osric says faintly, and starts checking you for wounds."],
              dread: ["Osric murmurs a prayer under his breath, and the shadows seem a little farther away."],
              end: ["Osric hugs you, then apologizes, then hugs you again. 'I am so glad you are alive.'"] } },
  pip: { name: "Pip Copperkettle", short: "Pip", title: "cheerful smallfolk cutpurse", role: "Trickster", skills: ["Pilfering", "Stealth"], fee: 5,
    weaken: 1, t3: { weaken: 2 },
    roleText: "Throws foes off, so they attack with 1 fewer die each round (2 at Trust 3).",
    pitch: ["'I am not a thief,' Pip says, and a purse you had forgotten about drops into your hand. 'I am a very quick borrower. Take me along? I am great in a fight. From a distance.'"],
    talk: [
      ["Pip chatters as he works a lockpick between his fingers. 'Grew up in the Highmarket gutters, third of nine. Every one of us learned to fight dirty or not at all.' He grins. 'I picked dirty.'"],
      ["'People think thieves have no rules,' Pip says. 'We have loads. Never take from a friend. Never take the last of anything. Never leave a mate.' He looks at you. 'That last one is the big one.'"],
      ["Pip drops a small lump of silver into your pocket. 'That one is a gift, not a borrow,' he says. 'First one I have ever given.' (Trust 3: he throws foes off even more.)"]],
    chat: ["Pip juggles three stolen apples. 'They are mine now. Legally. Ish.'", "'You know what I like about you?' Pip says. 'You do not check your pockets after I hug you.'"],
    banter: { victory: ["'Did you see that?' Pip crows. 'Did you SEE that? I distracted him with my whole personality.'", "'Anything on him worth borrowing?' Pip asks, already checking."],
              dread: ["Pip is unusually quiet. 'You know I talk when I am scared,' he whispers. 'That is how you know it is bad.'"],
              end: ["Pip tosses a stolen apple in the air and catches it. 'Best job I ever had. Let us do it again.'"] } },
  sable: { name: "Sable Marrowe", short: "Sable", title: "wry hellmarked spellwright", role: "Striker", skills: ["Occult", "Investigation"], fee: 12,
    pool: 3, dmg: 2, ignore: true, t3: { dmg: 3 },
    roleText: "Casts each round with 3 dice, damage 2, ignoring Guard (damage 3 at Trust 3).",
    pitch: ["'The horns are real,' Sable says dryly, 'and no, I do not want to talk about it. But I am very good at making things stop moving.'"],
    talk: [
      ["'People see the brand and assume the worst,' Sable says. 'I used to argue. Now I let them assume. It saves time.' She flicks a spark between her fingers. 'Most of them stop assuming when I set something on fire.'"],
      ["'My mother sold me for a bargain she never explained,' Sable says quietly. 'I do not know what was traded, or who holds the debt. I read everything I can find, hoping to find the clause.' She snaps a book shut. 'So far, nothing.'"],
      ["'You have not once asked me to hide it,' Sable says, touching the brand at her temple. She smiles, small and real. 'That counts for more than you know.' (Trust 3: her bolts hit harder.)"]],
    chat: ["Sable reads by the light of her own fingertips. 'Convenient,' she says. 'Do not tell the lantern.'", "'Ask me why I do not sleep,' Sable says. 'No, do not.'"],
    banter: { victory: ["Sable lowers her hand, sparks fading. 'Efficient.'", "'I would say it was a pleasure,' Sable says, 'but I would be lying.'"],
              dread: ["Sable's eyes flicker toward the dark. 'The brand itches when something old is near,' she says. 'It is itching.'"],
              end: ["Sable extends a hand. 'Whatever the debt is, at least this bargain was a fair one.'"] } },
  gar: { name: "Gar Thorne", short: "Gar", title: "big-hearted tuskborn brawler", role: "Striker", skills: ["Athletics", "Intimidation"], fee: 9,
    pool: 4, dmg: 3, t3: { pool: 5 },
    roleText: "Brawls each round with 4 dice, damage 3 (5 dice at Trust 3).",
    pitch: ["'Fight? Yes. Food? Also yes.' Gar grins around his tusks. 'Two things I am good at. Are we hiring?'"],
    talk: [
      ["'My mother was a farrier, my father an orc raider,' Gar says around a mouthful of bread. 'They met over a stolen horse. I have been apologizing to horses ever since.' He chews thoughtfully. 'Not really.'"],
      ["'When I was young I broke a man's arm in a fight I started,' Gar says. 'He forgave me, and that was worse.' He rolls his shoulders. 'Now I only hit people who are trying to hit someone else first.'"],
      ["'I was going to wander alone,' Gar says. 'It is easier. Nobody expects you back.' He knocks his knuckles against yours. 'You expected me back. That is new.' (Trust 3: he hits even harder.)"]],
    chat: ["Gar unwraps a lump of cheese the size of his fist. 'Want some? No? More for me.'", "'I have a theory,' Gar says. 'Most monsters are just hungry. I understand them. I just hit them anyway.'"],
    banter: { victory: ["Gar cracks his knuckles. 'Is there more? I am still warm.'", "'Somebody should tell it we were still eating,' Gar grumbles."],
              dread: ["Gar bares his tusks at the shadows. 'Come out and say that.' Then, quieter: 'Stay close.'"],
              end: ["Gar lifts you clean off the ground in a hug. 'Now can we eat? I am starving.'"] } },
  bram: { name: "Bram Holloway", short: "Bram", title: "caravan sergeant", role: "Guardian", skills: ["Athletics", "Perception"], fee: 0,
    guard: 1, t3: { guard: 2 },
    roleText: "Raises your Guard by 1 each round (2 at Trust 3).",
    pitch: ["'I owe you my voice,' Bram says, still hoarse. 'Let me pay it back with a sword.'"],
    talk: [
      ["Bram flexes his sword hand. 'Twenty years a guard. I never once lost a caravan until the Choir took mine. It sits on my chest.'"],
      ["'Maeve Thornbrook found me half-starved on a road,' Bram says. 'She gave me a coat and a job. I promised her I would never lose a cart.' He looks at you. 'Help me end this right.'"],
      ["'I have decided,' Bram says. 'When this is done, I am not going back to guarding carts. I am going with you, if you will have me.' (Trust 3: he becomes a stronger wall.)"]],
    chat: ["Bram checks the straps on his pack twice. 'Old habit,' he says."],
    banter: { victory: ["'That is another one that will not take a cart,' Bram says."], dread: ["'Steady,' Bram says, low and hoarse. 'We have walked worse.'"],
              end: ["Bram stands a little straighter. 'I got my voice back. Best day of my life.'"] } },
  tam: { name: "Tam Orrick", short: "Tam", title: "shaken young hauler", role: "Support", skills: ["Survival", "Discernment"], fee: 0,
    boost: 2, t3: { boost: 3 },
    roleText: "Calls out openings, giving your next attack +2 dice (+3 at Trust 3).",
    pitch: ["'I am not much of a fighter,' Tam whispers. 'But I know these tunnels. And I am tired of hiding.'"],
    talk: [
      ["Tam hums softly, then stops himself. 'It is a habit now. When I hum, I do not hear it.' He looks at his hands. 'I hummed for three weeks. My throat is raw.'"],
      ["'My father was a mine boss,' Tam says. 'He always said the dark is just a place without a lamp. I used to believe him.' He pulls his coat tighter. 'I think I need to believe him again.'"],
      ["'I want to go home,' Tam says. 'But first I want to see that thing put out. For all the ones who did not come home.' (Trust 3: he gives you even more heart.)"]],
    chat: ["Tam counts the lamps in the niches. 'Three hundred and twelve. I counted them every day.'"],
    banter: { victory: ["'You did it,' Tam breathes. 'I was so sure we would die.'"], dread: ["Tam starts to hum, then bites his lip. 'Sorry. It helps.'"],
              end: ["Tam looks up at the sky for a long time. 'I forgot it was so big,' he says."] } },
  vess: { name: "Harl Vess", short: "Vess", title: "sardonic sellsword captain", role: "Striker", skills: ["Intimidation", "Persuasion"], fee: 0,
    pool: 5, dmg: 2, t3: { dmg: 3 },
    roleText: "Fights each round with 5 dice, damage 2 (damage 3 at Trust 3).",
    pitch: ["'The Ledger is done,' Vess says with a shrug. 'But I still need work, and you look like the kind who pays.'"],
    talk: [
      ["Vess turns a coin over his knuckles. 'The keep never paid us. Yes, we deserted. They starved us first. I would do it again.' He shrugs. 'I would also do it better.'"],
      ["'You know the worst part of desertion?' Vess asks. 'You keep the training. You keep the reflexes. You just lose the reason.' He glances at you. 'Nice to have one again.'"],
      ["Vess tosses you a silver coin. 'Keep it. A captain should carry his luck.' He smiles crookedly. 'You are, for now, my captain.' (Trust 3: he hits harder.)"]],
    chat: ["Vess flips his coin and does not look at how it lands. 'I used to decide things with this. Now I decide them myself.'"],
    banter: { victory: ["'Not bad,' Vess says, flicking blood off his blade. 'For amateurs.'"], dread: ["Vess keeps his blade drawn and his voice light. 'Just a mine. We have all been in worse.'"],
              end: ["Vess salutes, half mocking, half not. 'Best contract I ever took.'"] } }
};
setup.hubRoster = {
  bell: ["kess", "wren", "pip", "osric"],
  rift: ["kess", "osric", "sable", "gar"],
  deep: ["wren", "pip", "sable", "gar"]
};
setup.inParty = function (id) { return State.variables.party.indexOf(id) >= 0; };
setup.cstat = function (id) {
  var c = setup.companions[id], t = (State.variables.trust || {})[id] || 0;
  return t >= 3 ? Object.assign({}, c, c.t3 || {}) : c;
};
setup.recruit = function (id) {
  var v = State.variables, c = setup.companions[id];
  if (v.party.length >= 2 || v.gold < c.fee || setup.inParty(id)) return false;
  v.gold -= c.fee; v.party.push(id);
  if (v.trust[id] === undefined) v.trust[id] = 0;
  return true;
};
setup.recruitStory = function (id) {
  var v = State.variables, c = setup.companions[id];
  if (setup.inParty(id)) { v.joinMsg = c.short + " is already with you."; return; }
  if (v.party.length >= 2) {
    v.joinMsg = c.name + " would come, but your party is full (2 companions). Send someone away from the party screen, then ask again.";
    return;
  }
  v.party.push(id);
  v.trust[id] = Math.max(1, v.trust[id] || 0);
  v.joinMsg = c.name + " joins your party. " + c.pitch[0];
};
setup.dismiss = function (id) {
  var v = State.variables, i = v.party.indexOf(id);
  if (i >= 0) v.party.splice(i, 1);
};
setup.partyTalk = function (id) {
  var v = State.variables, c = setup.companions[id];
  v.partyTalkId = id; v.partyTalkNote = "";
  if (v.campTalk[id]) {
    v.partyTalkText = [c.short + " has said what they had to say for now. Perhaps after your next rest."];
    return;
  }
  v.campTalk[id] = true;
  var lvl = v.trust[id] || 0;
  if (lvl < 3) {
    v.partyTalkText = c.talk[lvl];
    v.trust[id] = lvl + 1;
    v.partyTalkNote = (lvl + 1 >= 3) ? (c.short + "'s trust in you is complete. " + c.roleText) : (c.short + " trusts you a little more.");
  } else {
    v.partyTalkText = [c.chat[random(0, c.chat.length - 1)]];
  }
  if (v.crawling && v.dread > 0) { setup.easeDread(1); v.partyTalkNote += " -1 Dread."; }
};
setup.banter = function (kind) {
  var v = State.variables;
  if (!v.party || !v.party.length) return "";
  var id = v.party[random(0, v.party.length - 1)], lines = setup.companions[id].banter[kind];
  if (!lines || !lines.length) return "";
  return setup.companions[id].short + ": " + lines[random(0, lines.length - 1)];
};
setup.banterAll = function (kind) {
  var v = State.variables, out = [];
  (v.party || []).forEach(function (id) {
    var lines = setup.companions[id].banter[kind];
    if (lines && lines.length) out.push(setup.companions[id].short + ": " + lines[random(0, lines.length - 1)]);
  });
  return out;
};
setup.breakParty = function () {   /* uncommitted companions bolt when you break in the Deep */
  var v = State.variables, left = [];
  v.party = v.party.filter(function (id) {
    if ((v.trust[id] || 0) < 2) { left.push(setup.companions[id].short); return false; }
    return true;
  });
  v.leftNames = left;
};
setup.campCost = function () { return 1 + (State.variables.party.length >= 2 ? 1 : 0); };

/* ---------- Party turn in combat ---------- */
setup.partyTurn = function () {
  var v = State.variables, f = v.fight;
  v.partyGuard = 0; v.partyBoost = 0;
  v.party.forEach(function (id) {
    var c = setup.cstat(id), n = c.short;
    if (f.hp <= 0 && c.role === "Striker") return;
    if (c.role === "Guardian") {
      v.partyGuard += c.guard;
      f.log.push(n + " plants a shield in front of you (+" + c.guard + " Guard this round).");
    } else if (c.role === "Striker") {
      var p = setup.rollPool(c.pool, true);
      var guard = c.ignore ? 0 : f.guard;
      var net = p.hits - guard;
      var tag = c.pool + " dice: " + p.dice.join(" ") + " | Fate " + p.wild + " = " + p.hits + " hits vs Guard " + guard;
      if (net < 1) { f.log.push(n + " strikes but the blow is turned aside (" + tag + ")."); }
      else { var d = c.dmg + net; f.hp -= d; f.log.push(n + " hits (" + tag + ") for " + d + " damage."); }
    } else if (c.role === "Healer") {
      if ((c.healEvery === 1 || (f.round % 2 === 0)) && v.hp < v.maxhp) {
        f.log.push(n + " mends you, recovering " + setup.heal(c.heal) + " Stamina.");
      }
    } else if (c.role === "Trickster") {
      f.weak = (f.weak || 0) + c.weaken;
      f.log.push(n + " throws the foe off (-" + c.weaken + " attack " + (c.weaken > 1 ? "dice" : "die") + ").");
    } else if (c.role === "Support") {
      v.partyBoost += c.boost;
      f.log.push(n + " calls out an opening (+" + c.boost + " attack " + (c.boost > 1 ? "dice" : "die") + " next round).");
    }
  });
};

/* ---------- NPC dialogue ---------- */
setup.npcs = {
  maeve: { name: "Maeve Thornbrook", title: "merchant of Thornbrook & Daughters",
    greet: "Maeve is propped against a wall with her arm in a sling, watching the road as if the robed folk might walk out of it.",
    topics: [
      { id: "saw", label: "What did you see?", text: ["'They came out of the trees in ones and twos, all in grey. Not a word. Only this hum, low, like a beehive in the wall.'", "She shivers. 'The one leading carried a chalk-white staff. He was the only one whose lips moved, and I could not hear a thing. I could only watch him.'"],
        effect: function () { var v = State.variables; v.clues++; return "Clue gained: the leader's lips moved but no sound came. (+1 clue)"; } },
      { id: "caravan", label: "Tell me about your caravan.", text: ["'Thornbrook & Daughters. Four wagons, six guards, and my three girls running the depot in Highmarket while I do the hauling.' She smiles thinly. 'Or we did. The wagons are ruined, but the girls are fine. That is something.'"] },
      { id: "deal", label: "Any thanks for a helping hand?", req: function () { return State.variables.tended; },
        text: ["'You bound my arm and did not ask for a coin. That is worth more than coin.' She reaches into her purse. 'I will see the market gives you fair prices from now on.'"],
        effect: function () { State.variables.maeveDeal = true; return "Healing draughts cost 6 crowns at the market."; } },
      { id: "bram", label: "Who were your guards?", text: ["'Sergeant Bram Holloway led them. Ten years with me, and the best I ever had. If he is alive, he will be angry, not dead.' She looks toward the hills. 'Tell him his pay is doubled.'"],
        effect: function () { var v = State.variables; v.trust.bram = Math.max(v.trust.bram || 0, 1); return ""; } }
    ] },
  alden: { name: "Brother Alden", title: "priest of the Temple of First Light",
    greet: "Brother Alden holds a rag in one hand and a little brass polish in the other, and looks at the empty bell frame as if an old friend has left.",
    topics: [
      { id: "bell", label: "Tell me about the missing bell.", text: ["'We called her Morning Voice. Cast a hundred and ten years ago from a dozen village pots. She has rung every dawn since, and every funeral, and every wedding.' He wipes his eyes. 'You do not miss a sound until it is gone.'"] },
      { id: "choir", label: "Who were the Hollow Choir?", text: ["'A heresy, a century past. They taught that a bell's note carried a soul to the gods, and the greater the bell, the greater the soul.'", "'Their last warden, Veyle Marsh, was a bell-keeper at Dunvar Hold. He lost his wife and then his voice to grief. They say he never spoke again.' Alden sighs. 'I always felt sorry for him.'"],
        effect: function () { State.variables.gotDiscernment = true; return "You understand Veyle's grief. The parley will be easier."; } },
      { id: "break", label: "How do you break a bell?", text: ["'A bell is metal and a shaped note. Break the note and it is only metal. The old bell-wards did it three ways: a sharp counter-tone, a blessing of silence, or a hammer at the crown.'"],
        effect: function () { State.variables.sabHelp = true; return "Sabotaging the bell needs one less hit."; } },
      { id: "bless", label: "May I have a blessing?", text: ["He murmurs a short prayer and places his thumb on your brow. Then he presses a small vial into your hand. 'For the road.'"],
        effect: function () { State.variables.potions++; return "+1 healing draught."; } }
    ] },
  tomas: { name: "Tomas", title: "stablehand at the Gilded Heron",
    greet: "Tomas mucks out a stall with the nervous energy of a boy who has been listening to too many rumors.",
    topics: [
      { id: "road", label: "What do you know about the north road?", text: ["'Wolves,' Tomas says. 'Half-starved, and the pack has been driven off their hunting grounds by something. The one on the hill road is old and thin. Do not let it corner you and you will be fine.'"],
        effect: function () { State.variables.wolfWarn = true; return "The wolf on the road will be weaker."; } },
      { id: "stranger", label: "Seen any strangers lately?", text: ["'A grey-robed woman came through a week ago, buying rope and a chisel. Paid in old silver, the sort you never see anymore. She hummed the whole time. It made the horses nervous.'"] },
      { id: "life", label: "How is life at the Heron?", text: ["'Warm, mostly. The ale is bad but the fire is good, and the cook lets me sit by the hearth when it is cold.' He shrugs. 'It is better than the farm. It is a lot better than a lot of things.'"] }
    ] },
  corvin: { name: "Old Corvin", title: "barge-master",
    greet: "Old Corvin sits on an upturned bucket, mending a net, and gives you a grunt that might be a greeting.",
    topics: [
      { id: "hold", label: "Tell me about Dunvar Hold.", text: ["'My grandfather ran salvage there when the dwarves held it. Hall of Echoes is the tricky bit. Rune-plates in the floor. The old ones are worn where dwarven boots wore them, but the new ones are wired for darts.'"],
        effect: function () { State.variables.holdMap = true; return "The Hall of Echoes checks need one less hit."; } },
      { id: "river", label: "How is the river?", text: ["'Higher than it should be for the season. Something upstream is shifting the flow.' He squints at the water. 'Or I am getting old and complain.'"] },
      { id: "bell", label: "Why does the ferry bell matter to you?", text: ["'My father drowned in the fog on this river. The ferry bell was the only thing that got the rest of us home.' He looks at his empty hook. 'I have not slept right since it went.'"] }
    ] },
  bram: { name: "Sergeant Bram Holloway", title: "guard of Thornbrook & Daughters",
    greet: "Bram rubs his wrists, still red from the shackles. His voice is hoarse, as though he has been shouting for a week without a sound.",
    topics: [
      { id: "captured", label: "What happened to you?", text: ["'They came out of the trees humming. We drew steel, but the sound made our arms go slack. They took us one by one, and took our voices out of our throats.' He swallows. 'I keep checking that mine is still here.'"] },
      { id: "below", label: "What should I expect down below?", text: ["'A chamber with a big bell. A priest who weeps. The bell is the heart of it. Hit the crown, and the note breaks.' He points at his own head. 'That is what I would try.'"],
        effect: function () { State.variables.sabHelp = true; return "Sabotaging the bell needs one less hit."; } }
    ] },
  veyle: { name: "Choirmaster Veyle", title: "the Hollow Choir's last warden",
    greet: "Veyle does not move as you enter. The Hollow Bell hums behind him, and his tears fall as if they had been falling for years.",
    topics: [
      { id: "why", label: "Why did you take the bells?", text: ["'Bells carry voices,' he whispers. 'Every bell in this valley rang for something, a wedding, a funeral, a warning. I wanted to gather them, all those voices, and make something that could not be silenced again.'"] },
      { id: "lost", label: "What did you lose?", text: ["'My wife's voice. She sang in the temple choir. I cannot remember what she sounded like.' He touches his throat. 'The Hollow Bell remembers all the voices it ever heard. I hoped it might remember hers.'"],
        effect: function () { State.variables.gotDiscernment = true; return "You understand his grief. Parley will be easier."; } }
    ] },
  marrow: { name: "Warden-Captain Isolde Marrow", title: "commander of Thornwatch Keep",
    greet: "Marrow leans over her map table, four red circles inked around the ravine. She speaks without looking up.",
    topics: [
      { id: "ledger", label: "Tell me about the Crimson Ledger.", text: ["'Harl Vess was a good soldier. He was under my command for six years. When the coin stopped coming, half his company walked away. He is angry, not evil. He would take an honest offer over a fight.'"],
        effect: function () { State.variables.hintLedger = true; return "Bargaining with the Ledger needs one less hit."; } },
      { id: "cistern", label: "What about the old cistern?", text: ["'A hag lives there. Marga Crow. She has traded with this valley for a century. She likes coin and manners, in that order. Do not insult her, and she will not curse you.'"],
        effect: function () { State.variables.hintCistern = true; return "Haggling with Marga needs one less hit."; } },
      { id: "chaplain", label: "Who commanded the keep before you?", text: ["'A chaplain named Kessrick was the keep's spiritual officer for thirty years. He went into the Rift one winter to bury the dead from a rockslide and did not come back. I have wondered.'"],
        effect: function () { State.variables.kessrickLore = true; return "You know who Kessrick was. The parley will be easier."; } },
      { id: "keep", label: "Tell me about Thornwatch.", text: ["'A ring of towers built on a ridge to watch the Rift. It has done its job for two hundred years. The Rift was always empty, so nobody thought to ask why.'"] }
    ] },
  hessa: { name: "Hessa Brindle", title: "innkeeper of the Broken Shield",
    greet: "Hessa is polishing a mug that is already clean, and she has the look of someone who has heard every rumor in the valley twice.",
    topics: [
      { id: "spore", label: "What do you know about the glowing cave?", text: ["'Herders went in to shelter from a storm. Came out with their eyes gone flat. They will not speak but they will follow you. If you cut through the spores quick, the sick ones are slower.'"],
        effect: function () { State.variables.hintSpore = true; return "The Sporebound will have 2 less Stamina."; } },
      { id: "silk", label: "What about the silk caves?", text: ["'A spider, big as a cart. It hangs from the roof. Do not walk under the strands. Cut the anchors and the whole web comes down on it.'"],
        effect: function () { State.variables.hintSilk = true; return "The Silk-Weaver will have 2 less Stamina."; } },
      { id: "biz", label: "How is business?", text: ["'Terrible. Half my regulars are patrols that are not coming back. The other half drink to forget they might be next.' She sets down the mug. 'It is a living.'"] },
      { id: "history", label: "What is the Rift's history?", text: ["'Dwarves dug it looking for silver. Then something went wrong and they left. Then the keep went up. Then the keep forgot why.' She shrugs. 'Ask the Captain. She likes a good ghost story.'"] }
    ] },
  vess: { name: "Harl Vess", title: "captain of the Crimson Ledger",
    greet: "Vess sits with his boots on a barrel, a black stone hanging from his belt. He watches you with tired, amused eyes.",
    topics: [
      { id: "who", label: "Who are you?", text: ["'Harl Vess. Sergeant, then captain, then deserter, in that order.' He scratches his jaw. 'Thornwatch stopped paying us, so we stopped guarding. Simple math.'"] },
      { id: "want", label: "What does the Ledger want?", text: ["'A pardon. A fair contract. A fire and a roof.' He shrugs. 'Not much, when you say it out loud. Nobody ever asks.'"],
        effect: function () { State.variables.vessWants = true; return "Bargaining or facing down the Ledger needs one less hit."; } },
      { id: "stone", label: "Where did you get the black stone?", text: ["'It was lying in the cave mouth. It hums, if the wind is right.' He turns it over. 'I do not like it. But I do not like leaving things lying around, either.'"] }
    ] },
  marga: { name: "Marga Crow", title: "the hag of the Brine Cistern",
    greet: "Marga arranges a chessboard of bones on her driftwood throne, and does not look up. 'Mind the water,' she says. 'It bites.'",
    topics: [
      { id: "price", label: "What is your price?", text: ["'Everyone pays. Coin, name, or story. Coin is simplest, but stories keep.' She grins. 'I have not heard a new one in fifty years.'"] },
      { id: "priest", label: "Who is the priest in the vault?", text: ["'A pious fool who thought he could bargain with a fire. The idol at the far end burns things that should not burn. He fed it, bit by bit, and now it feeds on him.' She clicks a bone. 'I could have told him. Nobody asked.'"],
        effect: function () { State.variables.kessrickLore = true; return "You know the priest's story. The parley will be easier."; } },
      { id: "why", label: "Why do you live here?", text: ["'Quiet. Cold. Nobody stays to argue.' Her eyes go distant. 'I had a hearth once, and a house, and a name I answered to. This is better.'"] }
    ] },
  kessrick: { name: "Ash-Priest Kessrick", title: "keeper of the Ember Idol",
    greet: "Kessrick kneels at the idol's foot in charred vestments, his back to you. The black fire crackles softly, like a man muttering in his sleep.",
    topics: [
      { id: "before", label: "Who were you before this?", text: ["'A chaplain. I buried the dead of the rockslide, and I prayed over them, and no prayer answered. I grew tired of a God who did not answer.' He touches the idol. 'The ember answered.'"],
        effect: function () { State.variables.kessrickLore = true; return "You understand his despair. The parley will be easier."; } },
      { id: "idol", label: "What is the idol?", text: ["'A brazier of the old dwarves, meant to warm the deep halls. It burns what is given to it. I gave it prayers. Then names. Then years.' He shrugs. 'It gave me a kind of peace. I know how that sounds.'"] }
    ] },
  varn: { name: "Mine-Warden Ilse Varn", title: "warden of Orrow's Deep",
    greet: "Warden Varn watches the shaft mouth with a lantern held tight in both hands, as if it might be wrestled away.",
    topics: [
      { id: "wrong", label: "What went wrong in the mine?", text: ["'The lamps. First the ones in the lowest gallery, a week apart, then all of them. Not blown out. Just gone, as if they had never been lit. Then the crews stopped answering the signal-bells.' Her hands tighten. 'One of them was my brother.'"] },
      { id: "supplies", label: "Any supplies to spare?", text: ["She hands you a stoppered flask from under the winch. 'Lamp oil. The best I have. Do not waste it.'"],
        effect: function () { State.variables.flasks++; return "+1 oil flask."; } },
      { id: "foreman", label: "Who ran the mine before you?", text: ["'Foreman Orrow Venn. Sealed the bottom levels forty years back and swore it was safe. When I took over, I found his old journal in a strongbox at the assay office. I never read it. I did not want to know.'"],
        effect: function () { State.variables.knowsName = true; return "You know the name Orrow Venn."; } },
      { id: "crew", label: "Tell me about the crew.", text: ["'Forty-one miners. Two came out. One is at the bunkhouse, not speaking. The other, a young hauler named Tam Orrick, stayed below. He was the last to leave the surface.' She stops. 'I hope he is alive.'"] }
    ] },
  dorrin: { name: "Old Dorrin", title: "winch-keeper",
    greet: "Old Dorrin sits by the winch with a pipe he does not light, watching the rope as though it might snap.",
    topics: [
      { id: "advice", label: "Any advice for going below?", text: ["'The wraith at the gate hates a bright flame,' he says. 'Show it a little fire and it will go. My cousin did it once. Do not stay to see it burn.'"],
        effect: function () { State.variables.gateHint = true; return "Offering the Wick-Wraith light costs only 2 Light."; } },
      { id: "salt", label: "Any way to get holy salt cheaper?", text: ["'My cousin runs the salt cellar. Tell him I sent you.' He scribbles a note. 'Three crowns, not five. Do not tell the Warden.'"],
        effect: function () { State.variables.saltDeal = true; return "Holy salt costs 3 crowns."; } },
      { id: "stir", label: "What is the Stirring?", text: ["'The Deep notices you. Every step, every rest, every loud noise. When it has noticed enough, it sends something.' He taps his pipe. 'Move quiet. Rest short. Do not linger.'"] }
    ] },
  tam: { name: "Tam Orrick", title: "survivor",
    greet: "Tam sits by the altar with his knees drawn up and his hands around a dead lantern. He looks at you as though you might vanish.",
    topics: [
      { id: "how", label: "How did you survive?", text: ["'I found the chapel. The dark does not like the lamps here. Even dead ones. I stayed close to the altar and hummed until my throat bled.' He swallows. 'I think that helped.'"] },
      { id: "below", label: "What is below the Echo Hall?", text: ["'A gate. A wraith. It hates flame. I saw a miner offer it his lantern once, and it backed off.' He shudders. 'He did not come back. But it did back off.'"],
        effect: function () { State.variables.gateHint = true; return "Offering the Wick-Wraith light costs only 2 Light."; } }
    ] }
};
setup.talkTopic = function (npcId, topicId) {
  var v = State.variables, n = setup.npcs[npcId], topic = null;
  n.topics.forEach(function (x) { if (x.id === topicId) topic = x; });
  v.topicText = topic.text; v.topicNote = "";
  var key = npcId + "." + topicId;
  if (!v.talked[key]) {
    v.talked[key] = true;
    if (topic.effect) v.topicNote = topic.effect() || "";
  }
};

/* ---------- Combat: choose a stance each round ---------- */
setup.startFight = function (f) {
  var v = State.variables;
  v.fight = Object.assign({ loot: 0, weak: 0, round: 0 }, f);
  var np = (v.party || []).length;
  v.fight.hp = Math.ceil(f.hp * [1, 1.2, 1.55][np]);      /* bigger party, tougher foes */
  v.fight.max = v.fight.hp;
  v.partyGuard = 0; v.partyBoost = 0;
  v.fight.log = ["Steel is drawn. The fight begins!"];
  v.bracing = false; v.pressed = false;
};
setup.playerAttack = function (o) {
  o = o || {};
  var v = State.variables, f = v.fight, c = setup.classes[v.class];
  var pool = Math.max(1, v.final[c.atk] + 2 + (v.atkBonus || 0) + (o.dice || 0) + (v.partyBoost || 0) - setup.dreadPenalty());
  var guard = o.ignoreGuard ? 0 : Math.max(0, f.guard - (o.pierce || 0));
  var p = setup.rollPool(pool, true);
  var net = p.hits - guard;
  var tag = pool + " dice: " + p.dice.join(" ") + " | Fate " + p.wild + " = " + p.hits + " hits vs Guard " + guard;
  if (net < 1) { f.log.push("Your " + c.weapon + " is turned aside (" + tag + ")."); return false; }
  var dmg = c.dmg + net + (o.dmg || 0);
  f.hp -= dmg;
  f.log.push("Your " + c.weapon + " lands (" + tag + ") for " + dmg + " damage.");
  return true;
};
setup.enemyTurn = function () {
  var v = State.variables, f = v.fight;
  if (f.hp <= 0) return;
  var pool = Math.max(1, f.pool - (f.weak || 0));
  var guard = Math.max(0, v.guard + (v.bracing ? 2 : 0) - (v.pressed ? 1 : 0) + (v.partyGuard || 0));
  var p = setup.rollPool(pool, true);
  var net = p.hits - guard;
  var tag = pool + " dice: " + p.dice.join(" ") + " | Fate " + p.wild + " = " + p.hits + " hits vs your Guard " + guard;
  if (net < 1) {
    f.log.push("The " + f.name + " attacks but you turn it aside (" + tag + ").");
  } else {
    var dmg = f.dmg + net;
    v.hp -= dmg;
    f.log.push("The " + f.name + " hits you (" + tag + ") for " + dmg + " damage.");
    if (v.hp <= 0 && v.race === "Tuskborn" && !v.relentlessUsed) {
      v.hp = 1; v.relentlessUsed = true;
      f.log.push("Relentless! You refuse to fall and cling to 1 Stamina.");
    }
  }
  f.weak = 0; v.bracing = false; v.pressed = false; v.partyGuard = 0;
};
setup.act = function (kind) {
  var v = State.variables, f = v.fight;
  f.log = [];
  f.round = (f.round || 0) + 1;
  if (kind === "strike") {
    setup.playerAttack({});
  } else if (kind === "press") {
    v.pressed = true;
    f.log.push("You press the attack recklessly, leaving your defenses thin.");
    setup.playerAttack({ dice: 2 });
  } else if (kind === "brace") {
    v.bracing = true;
    f.log.push("You raise your guard and catch your breath, recovering " + setup.heal(1) + " Stamina.");
  } else if (kind === "feat") {
    v.sparks--;
    switch (v.class) {
      case "Blade": f.log.push("Cleaving Blow!"); setup.playerAttack({ dmg: 3 }); break;
      case "Shadow": f.log.push("You slip past their guard..."); setup.playerAttack({ dice: 3, pierce: 1 }); break;
      case "Spellwright": f.log.push("Raw force hammers your foe!"); setup.playerAttack({ ignoreGuard: true, dmg: 3 }); break;
      case "Vowed": f.log.push("A whispered prayer mends your wounds. You recover " + setup.heal(4 + v.final.pre) + " Stamina."); break;
      case "Wayfarer": f.log.push("You loose two arrows in one heartbeat!"); setup.playerAttack({}); if (f.hp > 0) setup.playerAttack({}); break;
      case "Voice": f.hp -= 3; f.weak = 3; f.log.push("Your cutting word draws blood and rattles your foe: 3 damage, and they will attack with 3 fewer dice."); break;
    }
  } else if (kind === "breath") {
    v.breath--; f.hp -= 4;
    f.log.push("You exhale a gout of draconic fire for 4 damage that ignores Guard!");
  } else if (kind === "potion") {
    v.potions--;
    f.log.push("You gulp a healing draught and recover " + setup.heal(setup.roll(1, 4) + 3) + " Stamina.");
  }
  v.partyBoost = 0;
  if (f.hp > 0) setup.partyTurn();
  if (f.hp > 0) setup.enemyTurn();
};

:: Story Stylesheet [stylesheet]
body { background: #1a140e; color: #eadfc4; font-family: Georgia, "Times New Roman", serif; }
#passages { max-width: 42rem; line-height: 1.55; }
h1, h2, h3 { color: #e3b448; font-variant: small-caps; letter-spacing: .04em; }
a, .macro-link, .link-internal { color: #e3b448; }
a:hover, .macro-link:hover { color: #fff1c9; }
#story-caption { font-size: .85em; }
.opt { margin: .6em 0; padding: .4em .7em; border-left: 3px solid #6b4f1d; background: rgba(0,0,0,.25); }
.opt small { color: #b8a880; }
.check { border-left: 4px solid; padding: .3em .7em; margin: .7em 0; font-size: .88em; background: rgba(0,0,0,.3); }
.check.pass { border-color: #6ab04c; }
.check.fail { border-color: #c0392b; }
.abrow { margin: .3em 0; }
.ablabel { display: inline-block; width: 8em; }
.abval { display: inline-block; width: 2em; text-align: center; font-size: 1.2em; }
.abnote { margin-left: 1em; color: #b8a880; font-size: .9em; }
.enemy { padding: .5em .8em; background: rgba(120,20,20,.35); border: 1px solid #7a2a2a; margin-bottom: .8em; }
.log p { margin: .3em 0; }
.actions .macro-link, .actions a { display: inline-block; margin: .2em .4em .2em 0; padding: .3em .8em; border: 1px solid #6b4f1d; border-radius: 4px; background: rgba(0,0,0,.3); }
.dim { color: #7d7259; }
table.sheet { border-collapse: collapse; margin: .6em 0; }
table.sheet th, table.sheet td { border: 1px solid #4a3a1a; padding: .3em .7em; text-align: center; }
.title-block { text-align: center; margin: 2em 0; }

:: Widgets [widget]
<<widget "chk">>
<<set _w to setup.check($args[0], $args[1], $args[2])>>
<<set _ok to _w.success>>
<div @class="'check ' + (_w.success ? 'pass' : 'fail')"><<= _w.skill>> (<<= _w.attribute>> <<= _w.base>><<if _w.trained>> + Trained 2<</if>><<if _w.extra>> + <<= _w.extraLabel>> <<= _w.extra>><</if>><<if _w.pen>> - Dread <<= _w.pen>><</if>><<if _w.aid>> + Aid (<<= _w.aidName>>) 1<</if>> = <<= _w.n>> dice, need <<= _w.need>> <<= (_w.need > 1) ? "hits" : "hit">>): <<= _w.dice.join(" ")>> | Fate <<= _w.wild>><<if _w.note>> (<<= _w.note>>)<</if>> = <b><<= _w.hits>> <<= (_w.hits === 1) ? "hit" : "hits">></b>. <<if _w.success>>Success.<<else>>Failure.<</if>></div>
<</widget>>

<<widget "move">>
<<set _dest to $args[0]>><<set _label to $args[1]>>
<<capture _dest>>
<<link _label>>
<<run setup.step()>>
<<if $dread gte 10>><<goto "DeepBroken">>
<<elseif $hunt>><<set $huntDest to _dest>><<goto "DeepHunt">>
<<else>><<goto _dest>><</if>>
<</link>>
<</capture>>
<</widget>>

<<widget "scare">>
<<chk "pre" "Resolve" $args[0]>>
<<if not _ok>>
<<run setup.gainDread($args[1])>>
<div class="check fail">Fear takes hold: <b>+<<= $args[1]>> Dread.</b></div>
<<set _bn to setup.banter("dread")>><<if _bn>><p><i><<= _bn>></i></p><</if>>
<</if>>
<<if $dread gte 10>><<goto "DeepBroken">><</if>>
<</widget>>

<<widget "packlink">>
<<link "Check your pack">><<set $packFrom to passage()>><<goto "DeepPack">><</link>>
<</widget>>

<<widget "camplink">>
<<if $prov gte setup.campCost()>>
<<link `"Make camp (" + setup.campCost() + (setup.campCost() > 1 ? " Provisions)" : " Provision)")`>><<set $campAt to passage()>><<run setup.camp()>><<if $hunt>><<set $huntDest to "DeepCamp">><<goto "DeepHunt">><<else>><<goto "DeepCamp">><</if>><</link>>
<<else>>
<span class="dim">No Provisions to camp with.</span>
<</if>>
<</widget>>

<<widget "talklink">>
<<set _npc to $args[0]>><<set _lbl to $args[1]>>
<<capture _npc>>
<<link _lbl>><<set $talkNpc to _npc>><<set $talkBack to passage()>><<goto "Talk">><</link>>
<</capture>>
<</widget>>

<<widget "joinlink">>
<<set _jid to $args[0]>><<set _jlbl to $args[1]>><<set _jback to $args[2]>>
<<capture _jid, _jback>>
<<link _jlbl>><<run setup.recruitStory(_jid)>><<set $joinBack to _jback>><<goto "PartyJoin">><</link>>
<</capture>>
<</widget>>

<<widget "partylink">>
<<link "Your party">><<set $partyBack to passage()>><<goto "Party">><</link>>
<</widget>>

<<widget "recruitlink">>
<<set _rh to $args[0]>>
<<capture _rh>>
<<link "Visit the wanderers' table">><<set $recruitHub to _rh>><<set $recruitBack to passage()>><<goto "Recruit">><</link>>
<</capture>>
<</widget>>

:: StoryInit
